{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@art/*": ["./src/assets/art/*"], "@audio/*": ["./src/assets/audio/*"] }
  },
  "include": ["src", "server", "shared", "jobs"]
}
